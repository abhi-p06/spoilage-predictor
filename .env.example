# ============================================================
# AgriRoute — Post-Harvest Spoilage Predictor
# .env.example  —  copy to .env and fill in your real values
# ============================================================

# ── Feature 1: Live Mandi Price (AGMARKNET via data.gov.in) ─────────
# 1. Go to https://data.gov.in/user/register and create a free account
# 2. Log in → My Account → API Keys → click "Generate Key"
# 3. Paste the key below (it looks like a long alphanumeric string)
DATA_GOV_API_KEY=your_data_gov_in_api_key_here

# ── Feature 2: Twilio SMS Alerts ────────────────────────────────────
# 1. Sign up for a free trial at https://www.twilio.com/try-twilio
# 2. After login, go to Console Dashboard — copy your Account SID and
#    Auth Token from the top of the page
# 3. Go to Phone Numbers → Manage → Active Numbers to get your Twilio number
#    (format: +1415XXXXXXX for US trial numbers)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1415XXXXXXX    # your Twilio phone number

# ── Flask ────────────────────────────────────────────────────────────
# Optional: override the Flask session secret key in production
FLASK_SECRET_KEY=change-me-in-production
